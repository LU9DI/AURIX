# Local-first default: no paid API key required. Install Ollama and pull a model first.
AURIX_PROVIDER=ollama
AURIX_BASE_URL=http://localhost:11434
AURIX_MODEL=qwen2.5-coder:7b
AURIX_API_KEY=

# Optional: use a local OpenAI-compatible server (LM Studio, llama.cpp, vLLM)
# AURIX_PROVIDER=openai-compatible
# AURIX_BASE_URL=http://localhost:1234/v1
# AURIX_MODEL=your-loaded-model-name
# AURIX_API_KEY=
AURIX_MAX_STEPS=6
AURIX_WORKSPACE=.
DATABASE_URL=
AURIX_SQLITE_PATH=.aurix/memory.db

AURIX_TELEMETRY_PATH=.aurix/runs.jsonl

# Optional autonomous peer consultation. Only explicitly listed endpoints are contacted.
# Keep credentials in environment variables; never place secrets in this JSON.
# Example: AURIX_PEER_PROVIDERS=[{"name":"local-reviewer","provider":"ollama","base_url":"http://localhost:11434","model":"qwen2.5-coder:7b"},{"name":"local-critic","provider":"openai-compatible","base_url":"http://localhost:1234/v1","model":"your-loaded-model","api_key_env":"LOCAL_MODEL_API_KEY"}]
AURIX_PEER_PROVIDERS=[]

# Optional autonomous public-web research via a user-managed SearXNG instance.
# Leave empty to disable web research. The SearXNG endpoint itself may be local.
AURIX_SEARXNG_URL=
AURIX_RESEARCH_MAX_RESULTS=3
AURIX_RESEARCH_MAX_CHARS=12000
AURIX_RESEARCH_FETCH_PAGES=true
